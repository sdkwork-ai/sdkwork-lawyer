# Dependencies
node_modules/
.pnpm-store/
node_modules/.cache/

# Build output produced by tool-native owners
dist/
build/
out/
target/
.dart_tool/
oh_modules/
.gradle/
coverage/
*.tsbuildinfo

# Compiler emit must never be tracked beside its source (REPOSITORY_BASELINE_SPEC.md §2)
*.js.map
*.d.ts.map

# Local environment files and secrets
.env
.env.*
*.local.secrets

# Agent workspace local-only state (SDKWORK_WORKSPACE_SPEC.md §6)
.sdkwork/local/
.sdkwork/tmp/
.sdkwork/cache/
.sdkwork/secrets/
.sdkwork/manual-backups/

# Source trees must not contain generated-state namespaces
.runtime/
**/.runtime/

# Editor and operating-system noise
.DS_Store
Thumbs.db
.idea/
*.log
